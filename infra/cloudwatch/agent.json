{
  "agent": {
    "run_as_user": "cwagent"
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/returnedholiday/audit.log",
            "log_group_name": "/returnedholiday/admin-audit",
            "log_stream_name": "{instance_id}"
          },
          {
            "file_path": "/var/log/returnedholiday/security.log",
            "log_group_name": "/returnedholiday/security",
            "log_stream_name": "{instance_id}"
          },
          {
            "file_path": "/var/log/returnedholiday/app.log",
            "log_group_name": "/returnedholiday/app",
            "log_stream_name": "{instance_id}"
          },
          {
            "file_path": "/var/log/nginx/returnedholiday.access.log",
            "log_group_name": "/returnedholiday/nginx",
            "log_stream_name": "{instance_id}-access"
          },
          {
            "file_path": "/var/log/nginx/returnedholiday.error.log",
            "log_group_name": "/returnedholiday/nginx",
            "log_stream_name": "{instance_id}-error"
          }
        ]
      }
    }
  }
}
