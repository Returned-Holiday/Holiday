# 로컬용. .env로 복사 후 사용, 커밋 X
# 운영은 Secrets Manager (AWS_SECRET_ID, AWS_REGION)
# 키 생성: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DB_NAME=returnedholiday
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
CLOVA_OCR_URL=
CLOVA_OCR_SECRET=
